      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableCOMDATFolding>false</EnableCOMDATFolding>
      <OptimizeReferences>false</OptimizeReferences>
      <AdditionalLibraryDirectories>%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>shlwapi.lib;Comctl32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <ModuleDefinitionFile>DIME.def</ModuleDefinitionFile>
      <LinkTimeCodeGeneration>UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
      <TargetMachine>MachineARM64X</TargetMachine>
      <ImageHasSafeExceptionHandlers>
      </ImageHasSafeExceptionHandlers>
    </Link>
    <PreBuildEvent>
      <Command>call .\BuildInfo.cmd</Command>
    </PreBuildEvent>
  </ItemDefinitionGroup>
  <!--
    Rust core (rust/crates/dime-core via dime-ffi), on by default: the dictionary engine,
    settings storage, composition, candidates and the key handler flow run in Rust, and the
    static library dime_ffi.lib is built by cargo before compiling (needs a Rust toolchain
    with the target of the platform). Release links the static CRT (matching /MT); Debug uses
    the dynamic CRT build (matching /MDd). The previous all-C++ build is still available:
      msbuild DIME.sln /t:DIME /p:Configuration=Release /p:Platform=x64 /p:DimeUseRustEngine=false
  -->
  <PropertyGroup Label="DimeRust">
    <DimeUseRustEngine Condition="'$(DimeUseRustEngine)'==''">true</DimeUseRustEngine>
    <DimeRustRoot>$(ProjectDir)..\rust\</DimeRustRoot>
    <DimeRustTarget Condition="'$(Platform)'=='Win32'">i686-pc-windows-msvc</DimeRustTarget>
    <DimeRustTarget Condition="'$(Platform)'=='x64'">x86_64-pc-windows-msvc</DimeRustTarget>
    <DimeRustTarget Condition="'$(Platform)'=='ARM64'">aarch64-pc-windows-msvc</DimeRustTarget>
    <DimeRustTarget Condition="'$(Platform)'=='ARM64EC'">arm64ec-pc-windows-msvc</DimeRustTarget>
    <DimeRustEnabled Condition="'$(DimeUseRustEngine)'=='true' And '$(DimeRustTarget)'!=''">true</DimeRustEnabled>
    <DimeRustTargetDir Condition="'$(Configuration)'=='Release'">$(DimeRustRoot)target\crt-static\</DimeRustTargetDir>
    <DimeRustTargetDir Condition="'$(Configuration)'!='Release'">$(DimeRustRoot)target\</DimeRustTargetDir>
    <DimeRustFlags Condition="'$(Configuration)'=='Release'">-C target-feature=+crt-static</DimeRustFlags>
    <DimeRustLibDir>$(DimeRustTargetDir)$(DimeRustTarget)\release\</DimeRustLibDir>
    <!-- ARM64X (ARM64EC with BuildAsX): the ARM64EC pass links the native ARM64 objects too, so it
         also needs the aarch64 dime_ffi.lib; the linker takes each half's symbols from the library
         of the matching machine type. -->
    <DimeRustArm64XNativeLibDir Condition="'$(Platform)'=='ARM64EC' And '$(BuildAsX)'=='true'">$(DimeRustTargetDir)aarch64-pc-windows-msvc\release\</DimeRustArm64XNativeLibDir>
    <DimeCargo Condition="Exists('$(USERPROFILE)\.cargo\bin\cargo.exe')">"$(USERPROFILE)\.cargo\bin\cargo.exe"</DimeCargo>
    <DimeCargo Condition="'$(DimeCargo)'==''">cargo</DimeCargo>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(DimeRustEnabled)'=='true'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(DimeRustRoot)crates\dime-ffi\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>DIME_RUST_AVAILABLE;DIME_USE_RUST_ENGINE;DIME_USE_RUST_CONFIG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(DimeRustLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>dime_ffi.lib;ntdll.lib;userenv.lib;ws2_32.lib;dbghelp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <IgnoreSpecificDefaultLibraries Condition="'$(Configuration)'!='Release'">msvcrt.lib;%(IgnoreSpecificDefaultLibraries)</IgnoreSpecificDefaultLibraries>
    </Link>
  </ItemDefinitionGroup>
  <Target Name="BuildDimeRust" BeforeTargets="ClCompile" Condition="'$(DimeRustEnabled)'=='true'">
    <Exec Command="$(DimeCargo) build --release --locked -p dime-ffi --target $(DimeRustTarget) --target-dir &quot;$(DimeRustTargetDir.TrimEnd('\'))&quot; --manifest-path &quot;$(DimeRustRoot)Cargo.toml&quot;" EnvironmentVariables="RUSTFLAGS=$(DimeRustFlags)" />
  </Target>
  <ItemDefinitionGroup Condition="'$(DimeRustEnabled)'=='true' And '$(DimeRustArm64XNativeLibDir)'!=''">
    <Link>
      <AdditionalDependencies>$(DimeRustArm64XNativeLibDir)dime_ffi.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <Target Name="BuildDimeRustArm64XNative" AfterTargets="BuildDimeRust" Condition="'$(DimeRustEnabled)'=='true' And '$(DimeRustArm64XNativeLibDir)'!=''">
    <Exec Command="$(DimeCargo) build --release --locked -p dime-ffi --target aarch64-pc-windows-msvc --target-dir &quot;$(DimeRustTargetDir.TrimEnd('\'))&quot; --manifest-path &quot;$(DimeRustRoot)Cargo.toml&quot;" EnvironmentVariables="RUSTFLAGS=$(DimeRustFlags)" />
  </Target>
  <Target Name="DimeRustUnsupportedPlatform" BeforeTargets="ClCompile" Condition="'$(DimeUseRustEngine)'=='true' And '$(DimeRustTarget)'==''">
    <Error Text="DimeUseRustEngine=true is not supported for platform $(Platform)." />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>

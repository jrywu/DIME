  <!--
    Rust migration (phase 2): build rust/crates/dime-ffi as a static library and link it
    so that RustParityTest.cpp can compare the C++ and Rust dictionary engines.
    Only Win32/x64 have a matching Rust target here; other platforms skip the parity tests.
  -->
  <PropertyGroup Label="DimeRust">
    <!-- Like DIME.dll, the tests build the product code with the Rust core by default;
         /p:DimeTestRustEngine=false tests the all-C++ build. -->
    <DimeTestRustEngine Condition="'$(DimeTestRustEngine)'==''">true</DimeTestRustEngine>
    <DimeRustRoot>$(ProjectDir)..\..\rust\</DimeRustRoot>
    <DimeRustTarget Condition="'$(Platform)'=='Win32'">i686-pc-windows-msvc</DimeRustTarget>
    <DimeRustTarget Condition="'$(Platform)'=='x64'">x86_64-pc-windows-msvc</DimeRustTarget>
    <DimeRustEnabled Condition="'$(DimeRustTarget)'!=''">true</DimeRustEnabled>
    <DimeRustLibDir>$(DimeRustRoot)target\$(DimeRustTarget)\release\</DimeRustLibDir>
    <DimeCargo Condition="Exists('$(USERPROFILE)\.cargo\bin\cargo.exe')">"$(USERPROFILE)\.cargo\bin\cargo.exe"</DimeCargo>
    <DimeCargo Condition="'$(DimeCargo)'==''">cargo</DimeCargo>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(DimeRustEnabled)'=='true'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(DimeRustRoot)crates\dime-ffi\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>DIME_RUST_AVAILABLE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(DimeRustLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>dime_ffi.lib;ntdll.lib;userenv.lib;ws2_32.lib;dbghelp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- Rust links against the release CRT; Debug builds use the debug CRT instead. -->
      <IgnoreSpecificDefaultLibraries Condition="'$(Configuration)'=='Debug'">msvcrt.lib;%(IgnoreSpecificDefaultLibraries)</IgnoreSpecificDefaultLibraries>
    </Link>
  </ItemDefinitionGroup>
  <!--
    /p:DimeTestRustConfig=true runs the whole suite with CConfig's storage in Rust
    (DIME_USE_RUST_CONFIG, as in DIME.dll / DIMESettings.exe built with DimeUseRustEngine=true).
  -->
  <ItemDefinitionGroup Condition="'$(DimeRustEnabled)'=='true' And '$(DimeTestRustConfig)'=='true'">
    <ClCompile>
      <PreprocessorDefinitions>DIME_USE_RUST_CONFIG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <!--
    DimeTestRustEngine (default true) builds the product code as DIME.dll with
    DimeUseRustEngine=true; /p:DimeTestRustEngine=false as the all-C++ DIME.dll.
  -->
  <ItemDefinitionGroup Condition="'$(DimeRustEnabled)'=='true' And '$(DimeTestRustEngine)'=='true'">
    <ClCompile>
      <PreprocessorDefinitions>DIME_USE_RUST_ENGINE;DIME_USE_RUST_CONFIG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <Target Name="BuildDimeRust" BeforeTargets="ClCompile" Condition="'$(DimeRustEnabled)'=='true'">
    <Exec Command="$(DimeCargo) build --release --locked -p dime-ffi --target $(DimeRustTarget) --manifest-path &quot;$(DimeRustRoot)Cargo.toml&quot;" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>